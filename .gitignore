# Device recovery, signing and machine-local setup material never belong in a
# source release. Synthetic test fixtures remain explicit reviewed Git files.
.env
.env.*
# Sanitized environment templates are source, never copies of live credentials.
!.env.example
!.env.sample
!.env.template
!.env.*.example
!.env.*.sample
!.env.*.template
*.key
*.pem
# Explicitly named public certificates may be reviewed and published.
!*.pub.pem
!*.cert.pem
!*.crt.pem
