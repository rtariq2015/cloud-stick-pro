--- upstream/security2.c
+++ patched/security2.c
@@ -77,8 +77,15 @@
 
 static inline void sec2_gcm_iv_counter_increment(uint8_t *iv_buf)
 {
-    aes_gcm_iv_t *iv = (aes_gcm_iv_t *) iv_buf;
-    iv->counter = htobe32(be32toh(iv->counter) + 1);
+    /* IV storage is byte-aligned in session_t. Do not cast it to a struct
+     * requiring uint32_t alignment. Byte operations preserve network order. */
+    uint32_t counter = ((uint32_t)iv_buf[8] << 24) | ((uint32_t)iv_buf[9] << 16) |
+                       ((uint32_t)iv_buf[10] << 8) | iv_buf[11];
+    ++counter;
+    iv_buf[8] = (uint8_t)(counter >> 24);
+    iv_buf[9] = (uint8_t)(counter >> 16);
+    iv_buf[10] = (uint8_t)(counter >> 8);
+    iv_buf[11] = (uint8_t)counter;
 }
 
 static esp_err_t sec2_new_session(protocomm_security_handle_t handle, uint32_t session_id);
